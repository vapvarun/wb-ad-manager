<?xml version="1.0"?>
<ruleset name="WB Ad Manager Coding Standards">
	<description>PHPCS ruleset for WB Ad Manager plugin.</description>

	<!-- What to scan -->
	<file>.</file>

	<!-- Exclude -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/bin/*</exclude-pattern>
	<exclude-pattern>/.wordpress-org/*</exclude-pattern>
	<exclude-pattern>/assets/js/*.min.js</exclude-pattern>
	<exclude-pattern>/assets/css/*.min.css</exclude-pattern>

	<!-- PHP files only -->
	<arg name="extensions" value="php"/>

	<!-- Show colors and progress -->
	<arg value="sp"/>
	<arg name="colors"/>

	<!-- WordPress standards: Core + Extra. Skip WordPress-Docs (docblock
	     completeness) — we rely on PHPStan for type/return correctness
	     and on PCP for ship-blocking issues. WPCS doc-sniffs produce
	     hundreds of "Missing doc comment" warnings across long-standing
	     production files that the plugin has shipped for multiple
	     versions without incident. -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra">
		<!-- File-header / class-header docblocks are already required
		     by WordPress-Core; the Extra ruleset's function docblock
		     sniffs are noisy on codebases that lean on PHPStan for
		     type info. -->
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<exclude name="Squiz.Commenting.ClassComment.Missing"/>
		<exclude name="Squiz.Commenting.FileComment.Missing"/>
		<exclude name="Squiz.PHP.CommentedOutCode.Found"/>
	</rule>

	<!-- Register wbam_icon as a trusted auto-escaped helper (returns pre-escaped markup). -->
	<config name="customAutoEscapedFunctions" value="wbam_icon"/>

	<!-- Plugin text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wb-ads-rotator-with-split-test"/>
			</property>
		</properties>
	</rule>

	<!-- Mark wbam_icon as a trusted escape helper (returns pre-escaped markup). -->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customAutoEscapedFunctions" type="array">
				<element value="wbam_icon"/>
			</property>
		</properties>
	</rule>

	<!-- Minimum supported PHP version -->
	<config name="minimum_supported_wp_version" value="5.8"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
