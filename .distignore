.distignore
.editorconfig
.gitattributes
.gitignore
.phpunit.result.cache
.phpcs.xml.dist
.eslintignore
.eslintrc.json
.stylelintrc.json
.pa11yci
composer.json
composer.lock
package.json
package-lock.json
Gruntfile.js
phpunit.xml
phpunit.xml.dist
phpcs.xml
phpcs.xml.dist
phpcbf.xml
phpcbf.xml.dist
phpstan.neon
phpstan.neon.dist
phpstan-bootstrap.php
phpstan-baseline.neon
phpstan-combined.neon.dist

# Marketing (don't ship to WP.org)
sales-page.html
marketing

